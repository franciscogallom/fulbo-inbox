ENVIRONMENT=local
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8000

# --- WhatsApp Cloud API ---
WHATSAPP_VERIFY_TOKEN=un-token-secreto-elegido-por-mi
WHATSAPP_APP_SECRET=reemplazar-con-el-app-secret-de-meta

# --- Redis / Cola ---
REDIS_URL=redis://localhost:6379/0

QUEUE_NAME=wsp_messages
CONSUMER_JOB_PATH=worker.procesar_mensaje
DEDUP_TTL_SECONDS=86400
